<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_window_workbook"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_window_short"
        android:shortcutLongLabel="@string/shortcut_new_window_long">
        <intent
            android:action="com.masusheet.app.action.SHORTCUT"
            android:targetPackage="com.masusheet.app"
            android:targetClass="com.masusheet.app.MainActivity">
            <extra android:name="masusheet_shortcut_mode" android:value="new_window" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="new_blank_workbook_window"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/shortcut_new_blank_short"
        android:shortcutLongLabel="@string/shortcut_new_blank_long">
        <intent
            android:action="com.masusheet.app.action.SHORTCUT"
            android:targetPackage="com.masusheet.app"
            android:targetClass="com.masusheet.app.MainActivity">
            <extra android:name="masusheet_shortcut_mode" android:value="new_blank" />
        </intent>
    </shortcut>
</shortcuts>
