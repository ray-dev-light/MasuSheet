<?xml version="1.0" encoding="utf-8"?>
<!-- [EN] Exclude encrypted API key storage from Android 12+ cloud backup and device transfer. -->
<!-- [JA] Android 12 以降のクラウドバックアップおよび端末移行から暗号化 API キー保管領域を除外します。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="masusheet_secure_secrets.xml" />
        <exclude domain="file" path="handoff" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="masusheet_secure_secrets.xml" />
        <exclude domain="file" path="handoff" />
    </device-transfer>
</data-extraction-rules>
